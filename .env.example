# Papertrust settings. Only PAPERTRUST_SECRET is required.
# Make secrets with: npx papertrust secret   (or: node bin/papertrust.mjs secret)

PAPERTRUST_SECRET=
PAPERTRUST_KEY_PASSWORD=
PAPERTRUST_ALLOWED_ORIGINS=http://localhost:3000
# PAPERTRUST_NAME=My company signer
# PAPERTRUST_DATA_DIR=./data
# PAPERTRUST_ROTATE_DAYS=365
# PAPERTRUST_MAX_RENDERS=2
# CHROMIUM_PATH=
# PORT=4100
